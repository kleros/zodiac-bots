<%- include('./components/layout-start', { title: 'New Reality Question '}) %>

<table width="100%" cellspacing="0" cellpadding="0" role="presentation" style="mso-table-lspace:0pt;mso-table-rspace:0pt;border-collapse:collapse;border-spacing:0px">
    <!-- Header -->
    <tr>
        <td align="left" style="padding:0;Margin:0;padding-top:25px;padding-bottom:40px">
            <h1 style="Margin:0;line-height:25.2px;mso-line-height-rule:exactly;font-family:'open sans', 'helvetica neue', helvetica, arial, sans-serif;font-size:21px;font-style:normal;font-weight:normal;color:#daf0ff">Hi there!</h1>
            <h1 style="Margin:0;line-height:25.2px;mso-line-height-rule:exactly;font-family:'open sans', 'helvetica neue', helvetica, arial, sans-serif;font-size:21px;font-style:normal;font-weight:normal;color:#daf0ff">A new Reality question has been created for a Snapshot proposal in the space <%- notification.space.ens %>.</h1>
        </td>
    </tr>
    <!-- /Header -->

    <!-- Validation warning -->
    <tr>
        <td align="left" style="padding:0;Margin:0;padding-bottom:20px">
            <table width="100%" cellpadding="0" cellspacing="0" role="presentation" style="mso-table-lspace:0pt;mso-table-rspace:0pt;border-collapse:collapse;border-spacing:0px">
                <tr>
                    <td style="padding:14px 14px 12px 14px;Margin:0;border:1px solid #7a5a14;background-color:#241b0a;border-radius:8px">
                        <p style="Margin:0;-webkit-text-size-adjust:none;-ms-text-size-adjust:none;mso-line-height-rule:exactly;font-family:'open sans', 'helvetica neue', helvetica, arial, sans-serif;line-height:19.2px;color:#ffe7b3;font-size:14px;font-weight:700">
                            ⚠️WARNING: Unable to validate proposal keccak hash ⚠️
                        </p>

                        <p style="Margin:0;padding-top:8px;-webkit-text-size-adjust:none;-ms-text-size-adjust:none;mso-line-height-rule:exactly;font-family:'open sans', 'helvetica neue', helvetica, arial, sans-serif;line-height:16.8px;color:#ffe7b3;font-size:12px">
                            We were unable to complete the automated keccak validation. This does not necessarily indicate an attack. Reason:
                        </p>

                        <table width="100%" cellpadding="0" cellspacing="0" role="presentation" style="mso-table-lspace:0pt;mso-table-rspace:0pt;border-collapse:collapse;border-spacing:0px;margin-top:10px">
                            <tr>
                                <td style="padding:10px 12px;Margin:0;background-color:#1a1307;border-left:3px solid #fbbf24">
                                    <p style="Margin:0;-webkit-text-size-adjust:none;-ms-text-size-adjust:none;mso-line-height-rule:exactly;font-family:ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace;line-height:16.8px;color:#ffe7b3;font-size:12px;white-space:pre-wrap;word-break:break-word">
<%- notification.validationMessage %>
                                    </p>
                                </td>
                            </tr>
                        </table>

                        <p style="Margin:0;padding-top:10px;-webkit-text-size-adjust:none;-ms-text-size-adjust:none;mso-line-height-rule:exactly;font-family:'open sans', 'helvetica neue', helvetica, arial, sans-serif;line-height:16.8px;color:#ffd98a;font-size:11px">
                            Manual review required: treat this as a potential security risk until verified.
                        </p>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
    <!-- /Validation warning -->

    <%- include('./components/event-links') %>

    <!-- Summary -->
    <tr>
        <td align="center" style="padding:0;Margin:0;padding-top:25px;padding-bottom:25px;font-size:0">
            <table border="0" width="100%" height="100%" cellpadding="0" cellspacing="0" role="presentation" style="mso-table-lspace:0pt;mso-table-rspace:0pt;border-collapse:collapse;border-spacing:0px">
                <tr>
                    <td style="padding:0;Margin:0;border-bottom:1px solid #42498f;background:unset;height:1px;width:100%;margin:0px"></td>
                </tr>
            </table>
        </td>
    </tr>
    <tr>
        <td align="left" style="padding:0;Margin:0;padding-top:5px">
            <p style="Margin:0;-webkit-text-size-adjust:none;-ms-text-size-adjust:none;mso-line-height-rule:exactly;font-family:'open sans', 'helvetica neue', helvetica, arial, sans-serif;line-height:14.4px;color:#daf0ff;font-size:12px">Reality Question ID:</p>
        </td>
    </tr>
    <tr>
        <td align="left" style="padding:0;Margin:0;padding-top:5px;padding-bottom:15px">
            <p style="Margin:0;-webkit-text-size-adjust:none;-ms-text-size-adjust:none;mso-line-height-rule:exactly;font-family:'open sans', 'helvetica neue', helvetica, arial, sans-serif;line-height:14.4px;color:#becce5;font-size:12px"><%- notification.event.questionId %></p>
        </td>
    </tr>
    <tr>
        <td align="left" style="padding:0;Margin:0;padding-top:5px">
            <p style="Margin:0;-webkit-text-size-adjust:none;-ms-text-size-adjust:none;mso-line-height-rule:exactly;font-family:'open sans', 'helvetica neue', helvetica, arial, sans-serif;line-height:14.4px;color:#daf0ff;font-size:12px">Snapshot Proposal ID:</p>
        </td>
    </tr>
    <tr>
        <td align="left" style="padding:0;Margin:0;padding-top:5px;padding-bottom:40px">
            <p style="Margin:0;-webkit-text-size-adjust:none;-ms-text-size-adjust:none;mso-line-height-rule:exactly;font-family:'open sans', 'helvetica neue', helvetica, arial, sans-serif;line-height:14.4px;color:#becce5;font-size:12px"><%- notification.event.snapshotId %></p>
        </td>
    </tr>
    <!-- /Summary -->

    <!-- Automated security checks -->
    <tr>
        <td align="left" style="padding:0;Margin:0;padding-top:5px;padding-bottom:10px">
            <p style="Margin:0;-webkit-text-size-adjust:none;-ms-text-size-adjust:none;mso-line-height-rule:exactly;font-family:'open sans', 'helvetica neue', helvetica, arial, sans-serif;line-height:16.8px;color:#daf0ff;font-size:14px">
                Automated validation did <span style="font-weight:600">NOT run</span> - verify all of these yourself:
            </p>
        </td>
    </tr>

    <tr>
        <td align="left" style="padding:0;Margin:0;padding-top:8px;padding-bottom:18px">
            <table width="100%" cellpadding="0" cellspacing="0" role="presentation" style="mso-table-lspace:0pt;mso-table-rspace:0pt;border-collapse:collapse;border-spacing:0px">
                <tr>
                    <td valign="top" width="22" style="padding:0;Margin:0;font-size:16px;line-height:16px">
                        🟡
                    </td>
                    <td valign="top" style="padding:0;Margin:0">
                        <p style="Margin:0;-webkit-text-size-adjust:none;-ms-text-size-adjust:none;mso-line-height-rule:exactly;font-family:'open sans', 'helvetica neue', helvetica, arial, sans-serif;line-height:16.8px;color:#becce5;font-size:12px">
                            Verify the proposal Safe hash equals the keccak256 of the concatenated individual hashes
                        </p>
                    </td>
                </tr>
                <tr>
                    <td height="8" style="padding:0;Margin:0;line-height:8px;font-size:0">&nbsp;</td>
                    <td height="8" style="padding:0;Margin:0;line-height:8px;font-size:0">&nbsp;</td>
                </tr>
                <tr>
                    <td valign="top" width="22" style="padding:0;Margin:0;font-size:16px;line-height:16px">
                        🟡
                    </td>
                    <td valign="top" style="padding:0;Margin:0">
                        <p style="Margin:0;-webkit-text-size-adjust:none;-ms-text-size-adjust:none;mso-line-height-rule:exactly;font-family:'open sans', 'helvetica neue', helvetica, arial, sans-serif;line-height:16.8px;color:#becce5;font-size:12px">
                            Verify the hash embedded in the Reality.eth question matches the proposal Safe hash
                        </p>
                    </td>
                </tr>
                <tr>
                    <td valign="top" width="22" style="padding:0;Margin:0;font-size:16px;line-height:16px">
                        🟡
                    </td>
                    <td valign="top" style="padding:0;Margin:0">
                        <p style="Margin:0;-webkit-text-size-adjust:none;-ms-text-size-adjust:none;mso-line-height-rule:exactly;font-family:'open sans', 'helvetica neue', helvetica, arial, sans-serif;line-height:16.8px;color:#becce5;font-size:12px">
                            Confirm the proposal passed on Snapshot
                        </p>
                    </td>
                </tr>
                <tr>
                    <td height="8" style="padding:0;Margin:0;line-height:8px;font-size:0">&nbsp;</td>
                    <td height="8" style="padding:0;Margin:0;line-height:8px;font-size:0">&nbsp;</td>
                </tr>
                <tr>
                    <td valign="top" width="22" style="padding:0;Margin:0;font-size:16px;line-height:16px">
                        🟡
                    </td>
                    <td valign="top" style="padding:0;Margin:0">
                        <p style="Margin:0;-webkit-text-size-adjust:none;-ms-text-size-adjust:none;mso-line-height-rule:exactly;font-family:'open sans', 'helvetica neue', helvetica, arial, sans-serif;line-height:16.8px;color:#becce5;font-size:12px">
                            Confirm the question was created after the proposal resolved
                        </p>
                    </td>
                </tr>
                <tr>
                    <td height="8" style="padding:0;Margin:0;line-height:8px;font-size:0">&nbsp;</td>
                    <td height="8" style="padding:0;Margin:0;line-height:8px;font-size:0">&nbsp;</td>
                </tr>
                <tr>
                    <td valign="top" width="22" style="padding:0;Margin:0;font-size:16px;line-height:16px">
                        🟡
                    </td>
                    <td valign="top" style="padding:0;Margin:0">
                        <p style="Margin:0;-webkit-text-size-adjust:none;-ms-text-size-adjust:none;mso-line-height-rule:exactly;font-family:'open sans', 'helvetica neue', helvetica, arial, sans-serif;line-height:16.8px;color:#becce5;font-size:12px">
                            Confirm the proposal meets the DAO requirements
                        </p>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
    <!-- /Automated security checks -->

    <%- include('./components/unsubscribe') %>

</table>

<%- include('./components/layout-end') %>