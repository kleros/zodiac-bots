{
  "name": "@kleros/zodiac-bots",
  "version": "0.0.1",
  "description": "Zodiac Bots",
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "drizzle:generate": "yarn drizzle-kit generate:pg --config src/services/db/config.ts",
    "drizzle:drop": "yarn drizzle-kit drop --config src/services/db/config.ts",
    "drizzle:check": "yarn drizzle-kit check:pg --config src/services/db/config.ts",
    "drizzle:migrate": "node dist/services/db/migrate.js",
    "bot:run": "node dist/start.js",
    "test:all": "mocha",
    "test:coverage": "c8 --reporter html --reporter text --all --src ./src mocha",
    "test": "yarn test:coverage"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/chai": "^4.3.20",
    "@types/chai-as-promised": "^7.1.8",
    "@types/ejs": "^3.1.5",
    "@types/lodash": "^4.17.24",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.13.3",
    "@types/node-telegram-bot-api": "^0.64.15",
    "@types/nodemailer": "^7.0.12",
    "@types/pg": "^8.20.0",
    "@types/sinon": "^17.0.4",
    "c8": "^10.1.3",
    "chai": "^4.5.0",
    "chai-as-promised": "^7.1.2",
    "eslint-config-prettier": "9.1.0",
    "mocha": "^10.8.2",
    "prettier": "3.5.3",
    "sinon": "^17.0.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@slack/webhook": "^7.2.0",
    "bottleneck": "^2.19.5",
    "drizzle-kit": "^0.20.18",
    "drizzle-orm": "^0.30.10",
    "ejs": "^3.1.10",
    "envalid": "^8.2.0",
    "lodash": "^4.18.1",
    "node-telegram-bot-api": "^0.67.0",
    "nodemailer": "^7.0.13",
    "pg": "^8.22.0",
    "pino": "^9.14.0",
    "viem": "^2.55.5"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "packageManager": "yarn@4.7.0",
  "volta": {
    "node": "24.12.0",
    "yarn": "4.7.0"
  }
}
